    "@sahihi/db": "workspace:*",
    "@sahihi/emails": "workspace:*",
    "@sahihi/infra": "workspace:*",
    "@sahihi/pdf": "workspace:*",
    "bullmq": "6.3.9",
    "nodemailer": "8.0.11"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.2"
  }
}
