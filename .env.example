# ─── Shared ──────────────────────────────────────────────
NODE_ENV=development
DATABASE_URL=postgresql://sahihi:sahihi@localhost:5432/sahihi
# Optional: the schema owner for `prisma migrate` when DATABASE_URL is the restricted app role
# (a login role IN ROLE sahihi_app, see docs/security.md). Locally both can be the same user.
# MIGRATE_DATABASE_URL=postgresql://sahihi:sahihi@localhost:5432/sahihi
REDIS_URL=redis://localhost:6379

# Public URLs (no trailing slash)
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
# PORT=4000  # the API's listen port; the host sets it in production (defaults to API_URL's port)

# ─── Auth (better-auth) ──────────────────────────────────
# openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-32-byte-random-secret
# The web app proxies /api/* to the API (next.config.ts rewrites), so auth
# cookies are first-party on the web origin. Point this at the WEB origin.
BETTER_AUTH_URL=http://localhost:3000

# ─── Storage (S3 / MinIO locally) ────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=sahihi-documents
S3_ACCESS_KEY_ID=sahihi
S3_SECRET_ACCESS_KEY=sahihi-secret
S3_FORCE_PATH_STYLE=true

# ─── Email ───────────────────────────────────────────────
# "smtp" uses Mailpit locally; "postmark" in production
EMAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
POSTMARK_SERVER_TOKEN=
EMAIL_FROM="Sahihi <no-reply@sahihi.local>"

# ─── SMS OTP (optional, Africa's Talking) ────────────────
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=

# ─── Signing ─────────────────────────────────────────────
# Days a signing link stays valid by default
SIGNING_LINK_TTL_DAYS=14
# "internal" now; "ca" once a licensed CA is integrated
SIGNING_PROVIDER=internal

# Proxies in front of the API that append to X-Forwarded-For. The client IP (rate limits, audit
# trail) is the entry this many places from the right. Railway: 1. Behind an extra proxy/CDN: 2.
TRUSTED_PROXY_HOPS=1

# Web: origin of presigned S3 URLs (CSP connect-src/img-src for uploads and the PDF viewers).
# Defaults to http://localhost:9000 in development; REQUIRED for a production build/start.
# STORAGE_ORIGIN=https://your-bucket.s3.eu-west-1.amazonaws.com

# Development/tests only: allow http:// and private addresses for webhook endpoints (local
# receivers). Never in production: it turns off the webhook SSRF protection.
# WEBHOOKS_ALLOW_PRIVATE_URLS=true

# ── Observability (docs/observability.md) ──
LOG_LEVEL=info
# Error tracking (api, worker). Off when unset. The web uses NEXT_PUBLIC_SENTRY_DSN.
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# SENTRY_ENVIRONMENT=production
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# Staff-only queue dashboard at <api>/admin/queues. Off unless both are set.
# ADMIN_DASHBOARD_USER=ops
# ADMIN_DASHBOARD_PASSWORD=<at least 16 random characters>
