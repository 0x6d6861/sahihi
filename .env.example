# ─── Shared ──────────────────────────────────────────────
NODE_ENV=development
DATABASE_URL=postgresql://sahihi:sahihi@localhost:5432/sahihi
# Optional: the schema owner for `prisma migrate` when DATABASE_URL is the restricted app role
# (a login role IN ROLE sahihi_app, see docs/security.md). Locally both can be the same user.
# MIGRATE_DATABASE_URL=postgresql://sahihi:sahihi@localhost:5432/sahihi
REDIS_URL=redis://localhost:6379

# Public URLs (no trailing slash)
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

# ─── Auth (better-auth) ──────────────────────────────────
# openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-32-byte-random-secret
# The web app proxies /api/* to the API (next.config.ts rewrites), so auth
# cookies are first-party on the web origin. Point this at the WEB origin.
BETTER_AUTH_URL=http://localhost:3000

# ─── Storage (S3 / MinIO locally) ────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=sahihi-documents
S3_ACCESS_KEY_ID=sahihi
S3_SECRET_ACCESS_KEY=sahihi-secret
S3_FORCE_PATH_STYLE=true

# ─── Email ───────────────────────────────────────────────
# "smtp" uses Mailpit locally; "postmark" in production
EMAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
POSTMARK_SERVER_TOKEN=
EMAIL_FROM="Sahihi <no-reply@sahihi.local>"

# ─── SMS OTP (optional, Africa's Talking) ────────────────
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=

# ─── Signing ─────────────────────────────────────────────
# Days a signing link stays valid by default
SIGNING_LINK_TTL_DAYS=14
# "internal" now; "ca" once a licensed CA is integrated
SIGNING_PROVIDER=internal
