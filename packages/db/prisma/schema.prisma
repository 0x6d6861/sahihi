// ─────────────────────────────────────────────────────────────────────────────
// Sahihi — Prisma schema
//
// Sections:
//   1. better-auth tables (User, Session, Account, Verification, Organization,
//      Member, Invitation). Shape is owned by better-auth — after upgrading
//      better-auth or adding plugins run `bun run auth:schema` and diff against
//      prisma/better-auth.generated.prisma before editing this section.
//   2. Domain tables. Every tenant-owned row carries `organizationId`.
//
// Enum values here MUST match the string unions in packages/core/src/enums.ts
// (enforced by packages/db/src/enums.test.ts).
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ═══ 1. better-auth ══════════════════════════════════════════════════════════

model User {
  id               String       @id
  name             String
  email            String       @unique
  emailVerified    Boolean      @default(false)
  image            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  twoFactorEnabled Boolean?     @default(false)
  sessions         Session[]
  accounts         Account[]
  members          Member[]
  invitations      Invitation[]
  twoFactors       TwoFactor[]
  passkeys         Passkey[]

  documents               Document[]
  envelopes               Envelope[]
  templates               Template[]
  envelopeAttachments     EnvelopeAttachment[]
  folders                 Folder[]
  webhooks                WebhookEndpoint[]
  exports                 DataExport[]
  apiKeys                 ApiKey[]
  bulkSends               BulkSend[]
  savedSignature          SavedSignature?
  avatar                  UserAvatar?
  notifications           Notification[]
  notificationPreferences NotificationPreference[]

  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// twoFactor plugin: TOTP secret and backup codes (both encrypted by better-auth).
model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

// @better-auth/passkey (Settings → Security, sign-in with a passkey; docs/auth.md)
model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime?
  aaguid       String?

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

model Organization {
  id          String       @id
  name        String
  slug        String       @unique
  logo        String?
  createdAt   DateTime
  metadata    String?
  members     Member[]
  invitations Invitation[]

  documents               Document[]
  envelopes               Envelope[]
  templates               Template[]
  folders                 Folder[]
  tags                    Tag[]
  webhooks                WebhookEndpoint[]
  subscription            Subscription?
  settings                WorkspaceSettings?
  exports                 DataExport[]
  apiKeys                 ApiKey[]
  bulkSends               BulkSend[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]

  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

// ═══ 2. Domain ═══════════════════════════════════════════════════════════════

enum DocumentStatus {
  UPLOADING // presigned URL issued, bytes not yet confirmed
  READY // hashed + inspected, usable in envelopes
  FAILED // invalid / encrypted / corrupt PDF
}

enum EnvelopeStatus {
  DRAFT
  SENT
  IN_PROGRESS
  COMPLETED
  DECLINED
  VOIDED
  EXPIRED
}

enum SigningOrder {
  PARALLEL
  SEQUENTIAL
}

enum RecipientRole {
  SIGNER // must complete their fields
  APPROVER // must approve; may have fields
  VIEWER // receives a copy (CC); never has fields
}

enum RecipientStatus {
  PENDING // not yet notified (e.g. waiting for their turn)
  SENT
  VIEWED
  SIGNED
  DECLINED
}

enum VerificationMethod {
  LINK // possession of the emailed link only
  EMAIL_OTP // link + 6-digit code by email
  SMS_OTP // link + 6-digit code by SMS (Africa's Talking)
}

enum FieldType {
  SIGNATURE
  INITIALS
  DATE_SIGNED
  NAME
  EMAIL
  TEXT
  CHECKBOX
}

enum SigningProviderKind {
  INTERNAL
  CA
}

/// An uploaded source PDF. Immutable once READY — never overwrite `s3Key`.
model Document {
  id                String             @id @default(cuid())
  organizationId    String
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedById      String
  uploadedBy        User               @relation(fields: [uploadedById], references: [id])
  name              String
  s3Key             String             @unique
  status            DocumentStatus     @default(UPLOADING)
  sizeBytes         Int?
  sha256            String?
  pageCount         Int?
  /// PageBox[] from @sahihi/core — unrotated crop box + rotation per page
  pages             Json?
  failureReason     String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  /// Envelopes and templates that use this document (ADR 0037: an envelope can hold several).
  envelopeDocuments EnvelopeDocument[]
  templateDocuments TemplateDocument[]
  /// Set when this document was produced by "Prepare document" from another one (same org).
  /// The source is never modified; this is lineage only.
  sourceDocumentId  String?
  source            Document?          @relation("DocumentLineage", fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  derived           Document[]         @relation("DocumentLineage")
  /// Folder on the Documents page (null = workspace root). Organisation only, no effect on signing.
  folderId          String?
  folder            Folder?            @relation(fields: [folderId], references: [id], onDelete: SetNull)
  /// Label colour (`#RRGGBB`, `LabelColorSchema`) and tags on the Documents page (ADR 0025).
  /// Organisation only, like folders.
  color             String?
  tags              Tag[]
  /// First-page preview PNG for the Documents grid, rendered by the worker once READY (ADR 0033).
  /// Same tenancy and presigned-only access as the PDF. Null until rendered.
  thumbnailKey      String?
  /// Why rendering failed; set so the backfill sweep doesn't retry a broken file forever.
  thumbnailError    String?

  @@index([organizationId, createdAt])
  @@index([organizationId, folderId, createdAt])
  @@index([sourceDocumentId])
}

/// Nested folders for organising documents, envelopes and templates (ADR 0022, 0038). Deleting a
/// folder moves its contents and subfolders up to its parent (done in the API; `NoAction` refuses orphaning yet lets an org delete cascade).
model Folder {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parentId       String?
  parent         Folder?      @relation("FolderTree", fields: [parentId], references: [id], onDelete: NoAction)
  children       Folder[]     @relation("FolderTree")
  createdById    String
  createdBy      User         @relation(fields: [createdById], references: [id])
  name           String
  /// Label colour (`#RRGGBB`, `LabelColorSchema`) and tags (ADR 0025).
  color          String?
  tags           Tag[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  documents      Document[]
  envelopes      Envelope[]
  templates      Template[]

  @@index([organizationId, parentId])
}

/// A workspace tag on folders, documents, envelopes and templates (ADR 0025, 0038). Created on first use; `key` is the
/// lowercased name, so "NDA" and "nda" are one tag. Unused tags are left in place (harmless).
model Tag {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  key            String
  createdAt      DateTime     @default(now())
  documents      Document[]
  folders        Folder[]
  envelopes      Envelope[]
  templates      Template[]

  @@unique([organizationId, key])
}

/// A signing request for one document with N recipients.
model Envelope {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User           @relation(fields: [createdById], references: [id])
  title          String
  message        String?
  status         EnvelopeStatus @default(DRAFT)
  signingOrder   SigningOrder   @default(PARALLEL)
  expiresAt      DateTime?
  sentAt         DateTime?
  completedAt    DateTime?
  voidedAt       DateTime?
  voidReason     String?
  /// "Download all" zip of the signed PDFs, certificate and supporting files (a convenience, not
  /// evidence; ADR 0037).
  bundleS3Key    String?
  /// Files and personal data deleted (retention or on request); evidence kept (docs/data-retention.md)
  purgedAt       DateTime?
  /// Folder and labels on the lists (ADR 0038). Organisation only: signing, evidence and webhooks
  /// never read them, so moving or labelling an envelope is not a state change.
  folderId       String?
  folder         Folder?        @relation(fields: [folderId], references: [id], onDelete: SetNull)
  color          String?
  tags           Tag[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  /// The documents to sign, in `order` (ADR 0037).
  documents     EnvelopeDocument[]
  /// Supporting files: shared with recipients, never signed.
  attachments   EnvelopeAttachment[]
  recipients    Recipient[]
  fields        Field[]
  auditEvents   AuditEvent[]
  certificate   Certificate?
  notifications Notification[]

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([organizationId, folderId, createdAt])
}

/// One document to sign in an envelope (ADR 0037). The document link is NO ACTION (checked at the
/// end of the statement): a document can't be removed under an envelope, yet deleting a workspace
/// cascades through both. Fields are placed on its pages; finalize stamps
/// it into its own signed PDF. The original `Document` is never modified.
model EnvelopeDocument {
  id           String   @id @default(cuid())
  envelopeId   String
  envelope     Envelope @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  documentId   String
  document     Document @relation(fields: [documentId], references: [id], onDelete: NoAction)
  /// 0-based position in the envelope.
  order        Int      @default(0)
  /// Stamped + flattened output (without certificate)
  signedS3Key  String?
  signedSha256 String?
  createdAt    DateTime @default(now())
  fields       Field[]

  @@unique([envelopeId, documentId])
  @@index([envelopeId, order])
  @@index([documentId])
  @@index([signedSha256])
}

/// A supporting file the sender shares with an envelope's recipients (ADR 0037): any allowed type,
/// never signed, always downloaded (never shown inline). Its hash is listed on the certificate.
/// Tenancy follows the envelope.
model EnvelopeAttachment {
  id           String         @id @default(cuid())
  envelopeId   String
  envelope     Envelope       @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  name         String
  contentType  String
  sizeBytes    Int
  sha256       String?
  s3Key        String         @unique
  status       DocumentStatus @default(UPLOADING)
  order        Int            @default(0)
  uploadedById String
  uploadedBy   User           @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime       @default(now())

  @@index([envelopeId, order])
  @@index([status, createdAt])
}

model Recipient {
  id              String             @id @default(cuid())
  envelopeId      String
  envelope        Envelope           @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  name            String
  email           String
  phone           String?
  role            RecipientRole      @default(SIGNER)
  /// 1-based routing order; equal values sign in parallel within SEQUENTIAL envelopes
  order           Int                @default(1)
  status          RecipientStatus    @default(PENDING)
  verification    VerificationMethod @default(LINK)
  /// EMAIL: invited/reminded by email. EMBEDDED: signs inside the sender's app (docs/embedded-signing.md)
  delivery        RecipientDelivery  @default(EMAIL)
  /// UI-only colour index for the field-placement editor
  colorIndex      Int                @default(0)
  /// SHA-256 (hex) of the signing token. The raw token is only ever in the email link.
  tokenHash       String?            @unique
  tokenExpiresAt  DateTime?
  notifiedAt      DateTime?
  lastRemindedAt  DateTime?
  reminderCount   Int                @default(0)
  viewedAt        DateTime?
  signedAt        DateTime?
  declinedAt      DateTime?
  declineReason   String?
  signedIp        String?
  signedUserAgent String?
  consentedAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  fields      Field[]
  otps        RecipientOtp[]
  auditEvents AuditEvent[]

  @@unique([envelopeId, email])
  @@index([envelopeId, order])
}

model RecipientOtp {
  id          String             @id @default(cuid())
  recipientId String
  recipient   Recipient          @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  codeHash    String
  channel     VerificationMethod
  expiresAt   DateTime
  attempts    Int                @default(0)
  consumedAt  DateTime?
  createdAt   DateTime           @default(now())

  @@index([recipientId, createdAt])
}

/// A placement on the document. Coordinates are NORMALIZED (0–1) relative to the
/// page as displayed (rotation applied), origin TOP-LEFT. See docs/coordinates.md.
model Field {
  id                 String           @id @default(cuid())
  envelopeId         String
  envelope           Envelope         @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  recipientId        String
  recipient          Recipient        @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  /// The document the field sits on (ADR 0037); `page` is 1-based within it.
  envelopeDocumentId String
  envelopeDocument   EnvelopeDocument @relation(fields: [envelopeDocumentId], references: [id], onDelete: Cascade)
  type               FieldType
  /// 1-based page number
  page               Int
  x                  Float
  y                  Float
  width              Float
  height             Float
  required           Boolean          @default(true)
  label              String?
  // ── completion ──
  value              String?
  /// S3 key of the PNG for SIGNATURE / INITIALS fields
  imageS3Key         String?
  filledAt           DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([envelopeId])
  @@index([recipientId])
}

/// Append-only, hash-chained log. NEVER update or delete rows.
/// hash = sha256(prevHash + canonicalJSON(event)). See packages/core/src/audit.ts.
model AuditEvent {
  id          String     @id @default(cuid())
  envelopeId  String
  envelope    Envelope   @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  seq         Int
  type        String
  recipientId String?
  recipient   Recipient? @relation(fields: [recipientId], references: [id], onDelete: NoAction)
  actorUserId String?
  data        Json?
  ipAddress   String?
  userAgent   String?
  occurredAt  DateTime
  prevHash    String?
  hash        String

  @@unique([envelopeId, seq])
  @@index([envelopeId, occurredAt])
}

model Certificate {
  id          String              @id @default(cuid())
  envelopeId  String              @unique
  envelope    Envelope            @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  /// Public verification code printed on the certificate / QR code
  code        String              @unique
  s3Key       String
  sha256      String
  provider    SigningProviderKind @default(INTERNAL)
  providerRef String?
  issuedAt    DateTime            @default(now())
}

/// A reusable envelope: a document, recipient roles and a field layout (docs/templates.md).
/// "Use" copies it into a new DRAFT envelope; the template itself never changes an envelope.
model Template {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User         @relation(fields: [createdById], references: [id])
  name           String
  description    String?
  /// Default envelope message
  message        String?
  signingOrder   SigningOrder @default(PARALLEL)
  /// Folder and labels on the lists (ADR 0038). Organisation only.
  folderId       String?
  folder         Folder?      @relation(fields: [folderId], references: [id], onDelete: SetNull)
  color          String?
  tags           Tag[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  bulkSends   BulkSend[]
  /// Fields are normalized to these PDFs' pages, so a template always carries its documents.
  /// Deleting a document is refused while templates use it (ADR 0012, 0037).
  documents   TemplateDocument[]
  attachments TemplateAttachment[]
  roles       TemplateRole[]
  fields      TemplateField[]

  @@index([organizationId, createdAt])
  @@index([organizationId, folderId, createdAt])
}

/// One document of a template, in `order` (ADR 0037).
model TemplateDocument {
  id         String          @id @default(cuid())
  templateId String
  template   Template        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  documentId String
  document   Document        @relation(fields: [documentId], references: [id], onDelete: NoAction)
  order      Int             @default(0)
  fields     TemplateField[]

  @@unique([templateId, documentId])
  @@index([templateId, order])
  @@index([documentId])
}

/// A supporting file kept with a template (ADR 0037). Its own copy of the object, so the template
/// outlives the envelope it was saved from; using the template copies it again.
model TemplateAttachment {
  id          String   @id @default(cuid())
  templateId  String
  template    Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name        String
  contentType String
  sizeBytes   Int
  sha256      String
  s3Key       String   @unique
  order       Int      @default(0)

  @@index([templateId, order])
}

/// A recipient slot ("Tenant", "Landlord"). Filled with a person when the template is used,
/// unless it has a fixed contact (e.g. the company's own countersigner).
model TemplateRole {
  id           String             @id @default(cuid())
  templateId   String
  template     Template           @relation(fields: [templateId], references: [id], onDelete: Cascade)
  label        String
  role         RecipientRole      @default(SIGNER)
  order        Int                @default(1)
  verification VerificationMethod @default(LINK)
  colorIndex   Int                @default(0)
  name         String?
  email        String?
  phone        String?

  fields TemplateField[]

  @@index([templateId, order])
}

model TemplateField {
  id                 String           @id @default(cuid())
  templateId         String
  template           Template         @relation(fields: [templateId], references: [id], onDelete: Cascade)
  roleId             String
  role               TemplateRole     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  templateDocumentId String
  templateDocument   TemplateDocument @relation(fields: [templateDocumentId], references: [id], onDelete: Cascade)
  type               FieldType
  page               Int
  x                  Float
  y                  Float
  width              Float
  height             Float
  required           Boolean          @default(true)
  label              String?

  @@index([templateId])
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCEEDED
  FAILED
}

/// An org's HTTPS endpoint for signed event POSTs (docs/webhooks.md). Owners/admins only.
model WebhookEndpoint {
  id              String            @id @default(cuid())
  organizationId  String
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById     String
  createdBy       User              @relation(fields: [createdById], references: [id])
  url             String
  description     String?
  /// WebhookEventType[] from @sahihi/core
  events          String[]
  enabled         Boolean           @default(true)
  /// Signing secret, AES-GCM encrypted (encryptSecret). It must be recoverable to sign, so it's
  /// encrypted rather than hashed, and it's only ever shown in full once.
  secretEncrypted String
  /// Last 4 characters, to tell secrets apart in the UI.
  secretHint      String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deliveries      WebhookDelivery[]

  @@index([organizationId])
}

/// One event for one endpoint: written in the same transaction as the state change (outbox),
/// then delivered by the worker with retries.
model WebhookDelivery {
  id             String                @id @default(cuid())
  endpointId     String
  endpoint       WebhookEndpoint       @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  organizationId String
  /// Event id sent to the receiver (their idempotency key). Same for every attempt.
  eventId        String
  type           String
  /// Event data snapshot at emission time
  payload        Json
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  lastAttemptAt  DateTime?
  lastStatusCode Int?
  lastError      String?
  lastResponse   String?
  deliveredAt    DateTime?
  createdAt      DateTime              @default(now())

  @@index([endpointId, createdAt])
  @@index([status, createdAt])
}

/// A workspace's plan (docs/billing.md). No row = Free. `plan` is a PlanId from @sahihi/core,
/// kept as a string so plans can change without a Prisma enum migration.
model Subscription {
  organizationId         String       @id
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan                   String       @default("free")
  /// Reserved for a payment provider (e.g. "paystack"); null while plans are set manually.
  provider               String?
  providerCustomerId     String?
  providerSubscriptionId String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
}

/// Per-workspace data settings (docs/data-retention.md). No row = defaults (keep forever).
model WorkspaceSettings {
  organizationId String       @id
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Years to keep closed envelopes before purging files and personal data; null = forever
  retentionYears Int?
  /// Origins allowed to show /sign in an iframe for EMBEDDED recipients (docs/embedded-signing.md)
  embedOrigins   String[]     @default([])
  /// Workspace logo (PNG) in storage; Organization.logo holds its public /api/branding URL
  logoKey        String?
  updatedAt      DateTime     @updatedAt
}

/// A user's profile picture (Settings → Profile): a square PNG in storage under user/{userId}/.
/// User.image holds its /api/avatars URL, served to the user and people sharing a workspace.
model UserAvatar {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  updatedAt DateTime @updatedAt
}

/// A user's own signature and initials (Settings → Profile), offered on signing pages addressed
/// to their email. PNGs in storage under user/{userId}/; never shared across users.
model SavedSignature {
  userId       String   @id
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  signatureKey String?
  initialsKey  String?
  updatedAt    DateTime @updatedAt
}

enum ExportStatus {
  PENDING
  READY
  FAILED
}

/// A ZIP of the workspace's envelopes, built by the worker (docs/data-retention.md).
model DataExport {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedById  String
  requestedBy    User         @relation(fields: [requestedById], references: [id])
  status         ExportStatus @default(PENDING)
  s3Key          String?
  sizeBytes      Int?
  envelopeCount  Int?
  error          String?
  createdAt      DateTime     @default(now())
  completedAt    DateTime?
  /// The archive is deleted after this (EXPORT_TTL_DAYS)
  expiresAt      DateTime?

  @@index([organizationId, createdAt])
}

/// Public API key (docs/public-api.md). Only the hash is stored; the key is shown once.
model ApiKey {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// The admin who created it: the actor recorded in audit trails for API actions
  createdById    String
  createdBy      User         @relation(fields: [createdById], references: [id])
  name           String
  /// sha256("api-key:" + key)
  secretHash     String       @unique
  /// "sahihi_sk_AbCd…WxYz", to tell keys apart
  hint           String
  /// ApiKeyScope[] from @sahihi/core
  scopes         String[]
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}

enum BulkSendStatus {
  PENDING
  RUNNING
  DONE
}

enum BulkSendItemStatus {
  PENDING
  SENT
  FAILED
}

/// One template sent to many people: one envelope per row (docs/bulk-send.md).
model BulkSend {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Kept as history if the template is deleted later
  templateId     String?
  template       Template?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdById    String
  createdBy      User           @relation(fields: [createdById], references: [id])
  title          String
  message        String?
  status         BulkSendStatus @default(PENDING)
  total          Int
  sent           Int            @default(0)
  failed         Int            @default(0)
  /// Set when started through the public API
  apiKeyId       String?
  createdAt      DateTime       @default(now())
  completedAt    DateTime?
  items          BulkSendItem[]

  @@index([organizationId, createdAt])
}

model BulkSendItem {
  id         String             @id @default(cuid())
  bulkSendId String
  bulkSend   BulkSend           @relation(fields: [bulkSendId], references: [id], onDelete: Cascade)
  /// 1-based row in the upload
  row        Int
  status     BulkSendItemStatus @default(PENDING)
  /// The row's people until processed; cleared afterwards (personal data lives on the envelope)
  recipients Json?
  /// Set as soon as the draft exists, so a retry sends it instead of creating a duplicate
  envelopeId String?
  error      String?

  @@unique([bulkSendId, row])
}

enum RecipientDelivery {
  EMAIL
  EMBEDDED
}

/// In-app notification for one user in one workspace (docs/notifications.md). Written in the same
/// transaction as the change it reports. Deleted after NOTIFICATION_TTL_DAYS and when its envelope
/// is purged (it holds names).
model Notification {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// NotificationType from @sahihi/core
  type           String
  envelopeId     String?
  envelope       Envelope?    @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  /// NotificationData from @sahihi/core: a snapshot of names and counts for display
  data           Json         @default("{}")
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([userId, organizationId, createdAt])
  @@index([userId, organizationId, readAt])
  @@index([envelopeId])
  @@index([createdAt])
}

/// A user's notification choices in one workspace. No row = defaults (NOTIFICATION_CATALOG).
model NotificationPreference {
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// NotificationSettings from @sahihi/core: only the types the user changed
  settings       Json         @default("{}")
  updatedAt      DateTime     @updatedAt

  @@id([userId, organizationId])
}
