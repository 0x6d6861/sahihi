                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Confidential Information does not include information that:",
                      "lineHeight": 1.6,
                      "fontFamily": "Inter",
                      "fontSize": 14,
                      "fontWeight": "normal",
                      "letterSpacing": -0.14
                    },
                    {
                      "type": "text",
                      "id": "YHKhj",
                      "name": "Text",
                      "fill": "#0b0b0b",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "(a) is or becomes public through no breach of this Agreement by the Receiving Party;",
                      "lineHeight": 1.6,
                      "fontFamily": "Inter",
                      "fontSize": 14,
                      "fontWeight": "normal",
                      "letterSpacing": -0.14
                    },
                    {
                      "type": "text",
                      "id": "ejaMR",
                      "name": "Text",
                      "fill": "#0b0b0b",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "(b) the Receiving Party already held without a duty of confidence before disclosure;",
                      "lineHeight": 1.6,
                      "fontFamily": "Inter",
                      "fontSize": 14,
                      "fontWeight": "normal",
                      "letterSpacing": -0.14
                    },
                    {
                      "type": "text",
                      "id": "LRjfo",
                      "name": "Text",
                      "fill": "#0b0b0b",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "(c) a third party lawfully disclosed to the Receiving Party without restriction; or",
                      "lineHeight": 1.6,
                      "fontFamily": "Inter",
                      "fontSize": 14,
                      "fontWeight": "normal",
                      "letterSpacing": -0.14
                    },
                    {
                      "type": "text",
                      "id": "I6NhQ1",
                      "name": "Text",
                      "fill": "#0b0b0b",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "(d) the Receiving Party independently developed without use of the Disclosing Party's Confidential Information.",
                      "lineHeight": 1.6,
                      "fontFamily": "Inter",
                      "fontSize": 14,
                      "fontWeight": "normal",
                      "letterSpacing": -0.14
                    }
                  ]
                }
