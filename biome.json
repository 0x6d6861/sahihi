{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!.claude/settings.local.json",
      "!**/.next",
      "!**/generated",
      "!apps/web/components/ui",
      "!apps/web/components/extend",
      "!apps/web/components/blocks",
      "!apps/web/hooks/use-media-query.ts",
      "!apps/web/lib/color-picker-utils.ts",
      "!apps/web/lib/pdf-thumbnail-utils.ts",
      "!apps/web/lib/segmented-control.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "asNeeded"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error"
      },
      "style": {
        "noNonNullAssertion": "warn"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
