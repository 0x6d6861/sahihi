{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!.claude/settings.local.json",
      "!**/.next",
      "!**/generated",
      "!apps/web/components/ui",
      "!apps/web/components/extend",
      "!apps/web/components/arc",
      "!apps/web/components/shadcn",
      "!apps/web/components/blocks",
      "!apps/web/hooks/use-media-query.ts",
      "!apps/web/lib/color-picker-utils.ts",
      "!apps/web/lib/pdf-thumbnail-utils.ts",
      "!apps/web/lib/segmented-control.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "asNeeded"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error"
      },
      "style": {
        "noNonNullAssertion": "warn"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": [
        "apps/web/**",
        "!apps/web/components/app/button.tsx",
        "!apps/web/components/app/button-link.tsx",
        "!apps/web/components/app/split-button.tsx",
        "!apps/web/components/app/badge.tsx",
        "!apps/web/components/app/fields.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@/components/arc/button/button": "Import Button from @/components/app/button (emerald primary, ADR 0060).",
                  "@/components/arc/split-button/split-button": "Import SplitButton from @/components/app/split-button (ADR 0060).",
                  "@/components/arc/badge/badge": "Import Badge from @/components/app/badge (info tone in blue, ADR 0060).",
                  "@/components/arc/input/input": "Import Input / Textarea / PasswordField from @/components/app/fields (shadcn fields until Arc's patch, ADR 0063).",
                  "@/components/arc/textarea/textarea": "Import Input / Textarea / PasswordField from @/components/app/fields (shadcn fields until Arc's patch, ADR 0063).",
                  "@/components/arc/password-field/password-field": "Import Input / Textarea / PasswordField from @/components/app/fields (shadcn fields until Arc's patch, ADR 0063).",
                  "@/components/shadcn/input": "Import Input / Textarea / PasswordField from @/components/app/fields (shadcn fields until Arc's patch, ADR 0063).",
                  "@/components/shadcn/textarea": "Import Input / Textarea / PasswordField from @/components/app/fields (shadcn fields until Arc's patch, ADR 0063)."
                }
              }
            }
          }
        }
      }
    }
  ]
}
